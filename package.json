{
  "name": "the-pool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "THE POOL — a single-scene, real-time liminal pool demo built for trailer-grade stills and motion.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shot": "bash scripts/run-browser.sh node scripts/shot.mjs",
    "stills": "bash scripts/run-browser.sh node scripts/stills.mjs",
    "trailer": "bash scripts/run-browser.sh node scripts/trailer.mjs",
    "perf": "bash scripts/run-browser.sh node scripts/perf.mjs",
    "determinism": "bash scripts/run-browser.sh node scripts/determinism.mjs",
    "camera-audit": "bash scripts/run-browser.sh node scripts/camera-audit.mjs",
    "water-audit": "bash scripts/run-browser.sh node scripts/water-audit.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "three": "0.186.1",
    "three-mesh-bvh": "0.9.17"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
